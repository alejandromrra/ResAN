{
  "name": "resan",
  "private": true,
  "version": "0.1.0",
  "description": "ResAN: SaaS de carta QR y pedidos en mesa para restauración",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @resan/api --filter @resan/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @resan/api db:generate",
    "db:seed": "pnpm --filter @resan/api db:seed"
  }
}
