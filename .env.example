# API (apps/api)
PORT=4000
# Sin DATABASE_URL la API usa PGlite (Postgres embebido) en memoria o en PGLITE_DIR.
# DATABASE_URL=postgres://resan:resan@localhost:5432/resan
# PGLITE_DIR=.pglite
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres-o-mas
# En desarrollo también se aceptan las IP de la red local (probar desde el móvil). En producción, solo esta lista.
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Solo desarrollo: crea el local demo al arrancar si no existe
SEED_DEMO=true

# Web (apps/web)
# Opcional: sin ella la web usa el mismo host en el puerto 4000 (útil para probar desde el móvil)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Producción (Docker / Easypanel) ---
# DATABASE_URL y JWT_SECRET son obligatorias. La imagen ya fija PORT=3000, API_PREFIX=/api y la web interna.
# Primer local y propietario (se crean al arrancar si no existen; después no se vuelven a aplicar):
# VENUE_NAME=Bar Pepe
# VENUE_SLUG=bar-pepe            # opcional: por defecto se deriva del nombre
# OWNER_NAME=Pepe
# OWNER_EMAIL=pepe@barpepe.es
# OWNER_PASSWORD=
# RATE_LIMIT_MAX=600             # peticiones/minuto por IP a la API
